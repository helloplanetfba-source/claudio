emo_josh_nancy_PHOTO_45.jpg","link":"","image_ratio":"adapt","width":"fill","custom_width":100,"width_mobile":"fill","custom_width_mobile":100,"height":"fit","border":"none","border_width":1,"border_opacity":100,"border_color":"","border_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"text_tVar7c":{"type":"text","name":"t:names.text","settings":{"text":"<h2><strong>Les 3 parcours 🅰️🅱️🅲<\/strong><\/h2>","width":"fit-content","max_width":"normal","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","text_color":"","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"image_bMkYLB":{"type":"image","name":"t:names.image","settings":{"image":"shopify:\/\/shop_images\/TRIPTYQUE_POUR_LUI_45.jpg","link":"","image_ratio":"adapt","width":"fill","custom_width":100,"width_mobile":"fill","custom_width_mobile":100,"height":"fit","border":"none","border_width":1,"border_opacity":100,"border_color":"","border_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"image_HawXkw":{"type":"image","name":"t:names.image","settings":{"image":"shopify:\/\/shop_images\/TRIPTYQUE_POUR_ELLE_45_1.jpg","link":"","image_ratio":"adapt","width":"fill","custom_width":100,"width_mobile":"fill","custom_width_mobile":100,"height":"fit","border":"none","border_width":1,"border_opacity":100,"border_color":"","border_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"text_nUEa3n":{"type":"text","name":"t:names.text","settings":{"text":"<h3><strong>TU AS DÉJÀ ENVIE. IL RESTE JUSTE CINQ CHOSES.<\/strong><\/h3><p><br\/><\/p><p>Je ne vais pas te dire qu'elles sont dans ta tête. Elles sont légitimes. Alors on les prend une par une.<\/p><p><br\/><\/p><p><strong>« Mon partenaire ne suivra jamais. »<\/strong><\/p><p>C'est le vrai frein. Et c'est celui que 90 % des programmes ignorent — ils te vendent un plan qui suppose que l'autre est motivé. Le tien ne l'est pas. Sinon tu ne serais pas ici.<\/p><p>Alors la <strong>première semaine ne lui demande rien.<\/strong><\/p><p>Sept jours entiers sur toi. Ta présence, ta façon d'occuper une pièce, ta façon de regarder. Aucun défi qui exige sa participation. Aucune conversation à provoquer. Aucun « chéri, j'ai commencé un truc, tu veux bien… ».<\/p><p>Tu ne lui demandes pas de changer. Tu changes. Et c'est lui qui vient voir ce qui se passe.<\/p><p><br\/><\/p><p><strong>« Et s'il tombe sur mon téléphone ? »<\/strong><\/p><p>Tu reçois un message par jour, sur WhatsApp, d'un contact qui s'appelle <strong>Flamme<\/strong>. Rien à installer. Aucune application sur ton écran d'accueil. Aucune notification qui affiche autre chose qu'un prénom.<\/p><p>Personne ne saura ce que tu fais. Personne ne saura que tu as lu quoi que ce soit.<\/p><p><strong>L'autre ne verra que le résultat.<\/strong><\/p>","width":"fit-content","max_width":"normal","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","text_color":"","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"image_UAeNXU":{"type":"image","name":"t:names.image","settings":{"image":"shopify:\/\/shop_images\/Untitled_design_2.jpg","link":"","image_ratio":"adapt","width":"fill","custom_width":100,"width_mobile":"fill","custom_width_mobile":100,"height":"fit","border":"none","border_width":1,"border_opacity":100,"border_color":"","border_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"image_PmxXC8":{"type":"image","name":"t:names.image","settings":{"image":"shopify:\/\/shop_images\/temo_fabiola_toulouse_11.jpg","link":"","image_ratio":"adapt","width":"fill","custom_width":100,"width_mobile":"fill","custom_width_mobile":100,"height":"fit","border":"none","border_width":1,"border_opacity":100,"border_color":"","border_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"text_kmXd3m":{"type":"text","name":"t:names.text","settings":{"text":"<p><strong>« Je n'ai pas le temps. »<\/strong><\/p><p>Quinze minutes. Une action par jour, précise, faisable ce soir.<\/p><p>Et si vous ne vivez pas ensemble, ou si vos horaires ne se croisent pas : <strong>le défi ne se déclenche pas à une heure fixe.<\/strong> Il attend votre prochain moment ensemble. Tu ne rates rien. Tu ne cours pas après un calendrier.<\/p><p><br\/><\/p><p><strong>« Je vais abandonner, comme les autres fois. »<\/strong><\/p><p>Peut-être. Alors c'est prévu.<\/p><p>Chaque semaine, tu as un <strong>jour joker<\/strong> : tu passes, sans te justifier, sans rien perdre. Tu reprends le lendemain là où tu t'es arrêté.<\/p><p>Rien dans ce programme ne te fera sentir en retard. C'est exactement pour ça que tu iras plus loin que d'habitude.<\/p><p><br\/><\/p><p><strong>« Je ne suis pas à l'aise avec ce genre de choses. »<\/strong><\/p><p>Pendant les <strong>deux premières semaines, aucun défi ne te demande de faire l'amour.<\/strong><\/p><p>Ce n'est pas de la pudeur, c'est de la méthode : la pression de performance tue le désir. On commence par te rendre présent. Le reste vient de lui-même — et il vient plus vite.<\/p><p><br\/><br\/><br\/><\/p>","width":"fit-content","max_width":"normal","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","text_color":"","background":false,"background_c